{
  "rules": {
    "forest": {
      "saves": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['d', 'at', 'v']) && newData.child('d').isString() && newData.child('d').val().length < 200000 && newData.child('at').isNumber() && newData.child('v').isString()"
        }
      },
      "rank": {
        ".read": "auth != null",
        ".indexOn": [
          "score",
          "ws"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'score', 'at']) && newData.child('at').isNumber() && newData.child('at').val() >= now - 60000 && newData.child('at').val() <= now + 60000 && ((!data.exists() && newData.child('score').val() <= 50000) || (data.exists() && data.child('score').isNumber() && data.child('at').isNumber() && newData.child('score').val() <= data.child('score').val() + 2000 + (now - data.child('at').val()) / 500))",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000000"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "tier": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "year": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "test": {
            ".validate": "newData.isBoolean()"
          },
          "pid": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Z]{6,16}$/)"
          },
          "week": {
            ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 9999"
          },
          "lp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999 && newData.val() <= (data.exists() && data.parent().child('week').val() === newData.parent().child('week').val() ? data.val() : 0) + 1000 + (data.parent().child('at').isNumber() ? (now - data.parent().child('at').val()) / 10000 : 0)"
          },
          "ws": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.parent().child('week').isNumber() && newData.parent().child('lp').isNumber() && newData.val() === newData.parent().child('week').val() * 1000000 + newData.parent().child('lp').val()"
          },
          "$other": {
            ".validate": false
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12 && newData.val().matches(/^[a-z]+$/)"
          }
        }
      },
      "stats": {
        ".read": "auth != null && root.child('forest/admins').child(auth.uid).val() === root.child('forest/adminKey').val()",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('forest/admins').child(auth.uid).val() === root.child('forest/adminKey').val()))",
          ".validate": "newData.hasChildren(['seen', 'pid']) && newData.child('seen').isNumber() && newData.child('pid').isString() && newData.child('pid').val().length <= 16",
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('forest/adminKey').exists() && newData.val() === root.child('forest/adminKey').val()))"
        }
      }
    }
  }
}
