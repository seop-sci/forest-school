<?xml version="1.0" encoding="utf-8"?>
<!-- 보안 보강(2026-11-06): 게임은 파일을 나누거나 고르지 않아요. 예전에는 휴대폰 저장소 전체(external-path ".")를 열어 두는 Capacitor 기본값이었어요.
     앱 자기 폴더(외부 앱 전용 폴더, 캐시)만 남겨요. provider는 exported=false라 다른 앱은 따로 허락받은 파일만 볼 수 있어요 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
</paths>
